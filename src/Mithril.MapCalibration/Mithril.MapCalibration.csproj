<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <RootNamespace>Mithril.MapCalibration</RootNamespace>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Microsoft.Extensions.Logging.Abstractions" />
  </ItemGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Mithril.MapCalibration.Tests" />
    <!-- mithril#1041: Legolas integration test exercises the real
         BundledBaselineLoader + UserRefinementStore + SceneAssetCache pieces
         to verify the cascade end-to-end without bootstrapping a host. -->
    <InternalsVisibleTo Include="Legolas.Tests" />
  </ItemGroup>
  <ItemGroup>
    <!-- Deliberately no ProjectReference to Mithril.Shared: this assembly is
         meant to be consumable by Mithril.Shared too (and by any module/peer)
         without depending up the layering. All it needs from outside is the
         DI + logging abstractions above. -->

    <!-- Arda.Contracts is the source of truth for IMapState, MapAssetChanged,
         IDomainEventSubscriber — types the cache + resolution helper + recorder
         need to talk to the world model. mithril#1041: the cache + resolution
         helper sit south of IMapState, so the dependency direction is naturally
         inward toward the contracts. NOTE: MapSceneRef physically lives in
         Arda.Contracts (src/Arda/Arda.Contracts/State/Player/MapSceneRef.cs)
         with namespace 'Mithril.MapCalibration' preserved — that placement
         broke what would otherwise have been a circular project reference
         between this project and Arda.Contracts. Same TFM (net10.0) at both
         ends so the consume direction is unambiguous. -->
    <ProjectReference Include="..\Arda\Arda.Contracts\Arda.Contracts.csproj" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="BundledData\map-calibration-baseline.json" />
    <!-- canonical-asset-hashes.json embeds our own SHA-256 hashes (not PG art):
         redistribution-clean, so it ships embedded. The icon-templates.{json,bin}
         PG-art blobs were REMOVED in #931 — the asset-extractor sidecar now
         re-derives those at runtime into a cache dir the loaders read BCL-only. -->
    <EmbeddedResource Include="BundledData\canonical-asset-hashes.json" />
  </ItemGroup>
</Project>
